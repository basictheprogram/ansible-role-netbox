# Managed by Ansible — do not edit manually
# Role: ansible-role-netbox_docker
# Host: {{ inventory_hostname }}
#
# Overlay merged with docker-compose.yml at runtime.
# Adds Traefik labels, network membership, and tunable healthcheck settings.

services:
  netbox:
    healthcheck:
      start_period: "{{ netbox_healthcheck_start_period }}"
    networks:
      - default                         # retain connectivity to postgres, redis, redis-cache
      - "{{ netbox_traefik_network }}"  # expose to Traefik for TLS termination and routing
    labels:
      traefik.enable: "true"
      traefik.http.routers.netbox.rule: "Host(`{{ netbox_fqdn }}`)"
      traefik.http.routers.netbox.entrypoints: "websecure"
      traefik.http.routers.netbox.tls: "true"
      traefik.http.routers.netbox.middlewares: "{{ netbox_traefik_middlewares | join(',') }}"
      traefik.http.services.netbox.loadbalancer.server.port: "8080"

networks:
  default: {}                    # project default network — created by docker-compose.yml
  "{{ netbox_traefik_network }}":
    external: true
